    {
      "name": "Secciones - Validación incorrecta (422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Datos inválidos - 422 Unprocessable Content\", function () {\r\n    pm.response.to.have.status(422);\r\n});\r\n\r\npm.test(\"La API identifica el campo obligatorio\", function () {\r\n    const respuesta = pm.response.json();\r\n\r\n    pm.expect(respuesta.errors).to.be.an(\"array\");\r\n\r\n    const errorNombre = respuesta.errors.find(\r\n        error => error.field === \"nombre\"\r\n    );\r\n\r\n    pm.expect(errorNombre).to.exist;\r\n    pm.expect(errorNombre.message).to.be.a(\"string\");\r\n});\r\n"
            ]
          }
        }
